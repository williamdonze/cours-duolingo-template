  ] },
  "boss": [
    { "id": "x-php-b1", "titre": "Le formulaire de la ville", "source": "Exemple du modèle", "notions": ["x-php-requete"],
      "enonce": "Si le formulaire est envoyé en POST, affiche « Bienvenue <ville> ! » avec le champ `city` (passé à `htmlspecialchars`) ; sinon, affiche « Choisis une ville ».",
      "depart": [""], "requete": { "methode": "POST", "post": { "city": "Yverdon" } },
      "tests": { "cas": [ { "titre": "Envoi : Yverdon", "requete": { "methode": "POST", "post": { "city": "Yverdon" } }, "sortie": ["Bienvenue Yverdon !"] },
                          { "titre": "Première visite (GET)", "requete": { "methode": "GET" }, "sortie": ["Choisis une ville"] },
                          { "titre": "Saisie piégée", "requete": { "methode": "POST", "post": { "city": "<b>Bulle</b>" } }, "neContientPas": ["<b>Bulle</b>"], "siEchec": "Passe la saisie dans `htmlspecialchars(…)`." } ] },
      "indices": ["Teste `$_SERVER[\"REQUEST_METHOD\"] === \"POST\"`.", "Dans le `if`, lis `$_POST[\"city\"]`.", { "texte": "La structure :", "code": "if (___) {\n    echo \"Bienvenue \" . htmlspecialchars(___) . \" !\";\n} else {\n    echo \"Choisis une ville\";\n}" }],
      "solution": ["if ($_SERVER[\"REQUEST_METHOD\"] === \"POST\") {", "    echo \"Bienvenue \" . htmlspecialchars($_POST[\"city\"]) . \" !\";", "} else {", "    echo \"Choisis une ville\";", "}"],
      "erreursTypiques": [ { "code": "if ($_SERVER[\"REQUEST_METHOD\"] === \"POST\") {\n    echo \"Bienvenue \" . $_POST[\"city\"] . \" !\";\n} else {\n    echo \"Choisis une ville\";\n}", "attendu": "echec" } ] }
  ]
