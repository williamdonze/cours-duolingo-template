        { "id": "x-php-l1-e2", "type": "trous", "notions": ["x-php-echo"], "question": "Complète : crée la constante `VAT`, puis affiche la TVA sur 100 francs.",
          "code": ["___ VAT = 0.081;", "$price = 100;", "echo $price * ___;"], "solution": ["const", "VAT"], "tests": { "cas": [{ "sortie": ["8.1"] }] },
          "indices": ["Le mot-clé qui crée une constante.", "Une constante s'utilise sans `$`."],
          "erreursTypiques": [{ "trous": ["const", "$VAT"], "attendu": "echec", "diagnostic": "variable-inconnue" }], "explication": "Une constante s'utilise par son nom, sans `$`." },
        { "id": "x-php-l1-e3", "type": "ecrire", "notions": ["x-php-echo"], "question": "Crée `$greeting` qui contient « Bonjour Ada, tu as 36 ans » avec `$name` et `$age`, puis affiche-la.",
          "donnees": { "name": "Ada", "age": 36 }, "depart": [""],
          "tests": { "cas": [ { "titre": "Ada, 36 ans", "variables": { "greeting": "Bonjour Ada, tu as 36 ans" }, "sortie": ["Bonjour Ada, tu as 36 ans"] },
                              { "titre": "Autres données", "donnees": { "name": "Linus", "age": 54 }, "variables": { "greeting": "Bonjour Linus, tu as 54 ans" } } ] },
          "indices": ["Colle les morceaux avec le point."],
          "solution": ["$greeting = \"Bonjour \" . $name . \", tu as \" . $age . \" ans\";", "echo $greeting;"],
          "erreursTypiques": [ { "code": "$greeting = \"Bonjour \" + $name + \", tu as \" + $age + \" ans\";\necho $greeting;", "attendu": "erreur", "diagnostic": "concat-plus" },
                               { "code": "$greeting = \"Bonjour Ada, tu as 36 ans\";\necho $greeting;", "attendu": "echec" } ],
          "explication": "Avec `.`, la phrase suit les données." },
        { "id": "x-php-l1-e4", "type": "bug", "notions": ["x-php-echo"], "question": "Quelle ligne plante ?", "code": ["$total = 3;", "echo \"Total : \" + $total;"], "ligne": 2,
          "choix": ["En PHP, on colle des textes avec `.`, pas `+`", "Il manque `<?php`", "`$total` n'existe pas"], "bonne": 0, "explication": "`+` additionne des nombres ; `.` colle des textes." }
      ] }
